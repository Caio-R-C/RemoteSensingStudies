// 3. Carregar, filtrar e pré‑escalar Sentinel‑2 SR (L2A)
var s2 = ee.ImageCollection('COPERNICUS/S2_SR')
  .filterBounds(buffer2)
  .filterDate('2007-06-14', '2024-05-30')
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 50))
  // para cada imagem, divide B4 por 10000 e mantém SCL:
  .map(function(img) {
    var b4 = img.select('B4').divide(10000).rename('B4');
    var scl = img.select('SCL');
    return b4.addBands(scl).copyProperties(img, img.propertyNames());
  });

// 4. Extrair para cada data a média da refletância B4 no buffer, só água
var withB4 = cms.map(function(f) {
  var date = ee.Date(f.get('Data'));
  var img  = s2
    .filterDate(date.advance(-15,'day'), date.advance(15,'day'))
    .sort('system:time_start')
    .first();
  // se não houver imagem, retorna null; senão, reduz a banda já escalada:
  var meanB4 = ee.Algorithms.If(
    img,
    img.updateMask(img.select('SCL').eq(6))  // só água
       .select('B4')
       .reduceRegion({
         reducer: ee.Reducer.mean(),
         geometry: buffer2,
         scale: 10,
         maxPixels: 1e8
       }).get('B4'),
    null
  );
  return f.set('B4', meanB4);
});

// 5. Filtrar apenas os registros com B4 != null
var valid = ee.FeatureCollection(withB4)
  .filter(ee.Filter.notNull(['B4']));

// 1. Aplicar linearFit() para obter a e b
var fit = valid.reduceColumns({
  reducer: ee.Reducer.linearFit(),
  selectors: ['B4', 'ConcentracaoMatSuspensao']
});
var a = fit.get('scale');
var b = fit.get('offset');
print('Inclinação (a):', a);
print('Intercepto (b):', b);

// 2. Calcular R² via pearsonsCorrelation()
var corrDict = valid.reduceColumns({
  reducer: ee.Reducer.pearsonsCorrelation(),
  selectors: ['B4', 'ConcentracaoMatSuspensao']
});
var r = ee.Number(corrDict.get('correlation'));
var r2 = r.pow(2);
print('Coeficiente de determinação (R²):', r2);

// 3. Gráfico de dispersão com linha de tendência
var chart = ui.Chart.feature.byFeature(valid, 'B4', 'ConcentracaoMatSuspensao')
  .setChartType('ScatterChart')
  .setOptions({
    title: 'B4 vs CSS (buffer 2 m, água)',
    hAxis: { title: 'Reflectância B4' },
    vAxis: { title: 'CSS (mg/L)' },
    trendlines: { 0: { showR2: true } },
    pointSize: 5
  });
print(chart);
