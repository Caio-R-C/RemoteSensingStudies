// =================================================================
// 1. DEFINIÇÃO DA ÁREA DE ESTUDO (INSIRA SEU ASSET AQUI)
// =================================================================
// Substitua o ID abaixo pelo caminho do seu Asset no GEE.
// Exemplo: 'users/seu_usuario/bacia_df'
var roi = ee.FeatureCollection('INSIRA_O_ID_DO_SEU_ASSET_AQUI');

// Centraliza o mapa na sua área
Map.centerObject(roi, 11);
Map.addLayer(roi.style({color: 'red', fillColor: '00000000'}), {}, 'Bacia (ROI)');

// =================================================================
// 2. PRECIPITAÇÃO (CHIRPS - MÉDIA ANUAL)
// =================================================================
// Usando CHIRPS Daily para calcular a precipitação média anual (ex: 1991-2020)
var chirps = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
    .filter(ee.Filter.date('1991-01-01', '2020-12-31'))
    .filterBounds(roi);

// Função para calcular a soma anual
var annualSum = function(year) {
  var start = ee.Date.fromYMD(year, 1, 1);
  var end = start.advance(1, 'year');
  return chirps.filterDate(start, end).sum().set('year', year);
};

var years = ee.List.sequence(1991, 2020);
var annualImages = ee.ImageCollection(years.map(annualSum));

// Média da série histórica
var precipMedia = annualImages.mean().clip(roi);

// Visualização
var precipVis = {
  min: 1000, max: 1800,
  palette: ['blue', 'cyan', 'yellow', 'orange', 'red']
};
Map.addLayer(precipMedia, precipVis, 'Precipitação Média (mm)');

// =================================================================
// 3. USO E COBERTURA DA TERRA (LULC - MAPBIOMAS / SENTINEL)
// =================================================================
// Usando MapBiomas Coleção 8 (Brasil) - já disponível no GEE como asset público
// Se preferir Sentinel-2 + Random Forest, o script seria bem mais longo.
var mapbiomas = ee.Image('projects/mapbiomas-public/assets/brazil/lulc/collection8/mapbiomas_collection80_integration_v1');

// Seleciona o ano mais recente (2022) e recorta para a ROI
var lulc = mapbiomas.select('classification_2022').clip(roi);

// Visualização (paleta simplificada para classes comuns no DF)
var lulcVis = {
  min: 1, max: 50,
  palette: [
    'ffffff', // 1 - Formação Florestal (branco)
    '129912', // 3 - Formação Florestal (verde escuro)
    'ffeda3', // 4 - Formação Savânica (amarelo)
    'd4a373', // 12 - Pastagem (marrom claro)
    'ff0000', // 24 - Infraestrutura Urbana (vermelho)
    '0000ff', // 33 - Rio/Lago (azul)
  ]
};
// Nota: A paleta é uma aproximação. O ideal é consultar a legenda do MapBiomas.
Map.addLayer(lulc, lulcVis, 'LULC 2022 (MapBiomas)');

// =================================================================
// 4. DECLIVIDADE (SLOPE - SRTM 30m)
// =================================================================
var srtm = ee.Image('USGS/SRTMGL1_003').clip(roi);

// Calcula a declividade (em graus)
var slope = ee.Terrain.slope(srtm);

// Visualização
var slopeVis = {
  min: 0, max: 45,
  palette: ['green', 'yellow', 'orange', 'red']
};
Map.addLayer(slope, slopeVis, 'Declividade (graus)');

// =================================================================
// 5. ÍNDICE DE UMIDADE TOPOGRÁFICA (TWI)
// =================================================================
// O TWI requer acumulação de fluxo. Usaremos o MERIT Hydro para facilitar.
var merit = ee.Image('MERIT/Hydro/v1_0_1');
var flowAcc = merit.select('upa').clip(roi); // Área de contribuição a montante

// Converter declividade para radianos e calcular tangente (evitando divisão por zero)
var slopeRad = slope.multiply(Math.PI).divide(180);
var tanSlope = slopeRad.tan().add(0.001); // epsilon para evitar zero

// Cálculo do TWI: ln(flowAcc / tanSlope)
var twi = flowAcc.divide(tanSlope).log().clip(roi).rename('TWI');

// Visualização
var twiVis = {
  min: 3, max: 15,
  palette: ['red', 'yellow', 'green', 'blue']
};
Map.addLayer(twi, twiVis, 'TWI (Índice de Umidade)');

