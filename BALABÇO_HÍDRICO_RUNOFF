// =============================================================================
// SCRIPT: CHUVA MENSAL + ESCOAMENTO (mm/mês) EM BACIA A PARTIR DE SHAPEFILE
// Para estudos de balanço hídrico
// =============================================================================

// ------------------------- 1. BACIA (SHAPEFILE) -------------------------
// Substitua pelo caminho do seu Asset (após fazer upload do shapefile)
var bacia = ee.FeatureCollection("users/SEU_USUARIO/nome_do_seu_shapefile").geometry();

// Caso queira testar rapidamente com um retângulo (apague depois):
// var bacia = ee.Geometry.Rectangle([-51.5, -30.5, -50.5, -29.5]);

Map.centerObject(bacia, 9);
Map.addLayer(bacia, {color: 'red'}, 'Bacia');

// ------------------------- 2. PERÍODO -------------------------
var startDate = '2015-01-01';
var endDate   = '2020-12-31';   // TRMM só vai até ~2019

// ------------------------- 3. COLEÇÕES -------------------------
// GPM (mm/h → 30 min)
var gpm = ee.ImageCollection('NASA/GPM_L3/IMERG_V07')
  .select('precipitation')
  .filterDate(startDate, endDate)
  .filterBounds(bacia);

// CHIRPS (mm/dia)
var chirps = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterDate(startDate, endDate)
  .filterBounds(bacia);

// TRMM 3B42 (mm/h → 3 horas) - disponível até final de 2019
var trmm = ee.ImageCollection('TRMM/3B42')
  .select('precipitation')
  .filterDate(startDate, endDate)
  .filterBounds(bacia);

// ERA5-Land - Runoff (já em metros de água → converter para mm)
var era5 = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY_AGGR')
  .select('runoff_sum')          // acumula o runoff do mês
  .filterDate(startDate, endDate)
  .filterBounds(bacia);

// ------------------------- 4. FUNÇÃO DE AGREGAÇÃO MENSAL -------------------------
function monthlyRainfall(collection, scaleFactor, bandName) {
  return ee.ImageCollection.fromImages(
    ee.List.sequence(0, ee.Date(endDate).difference(ee.Date(startDate), 'month').subtract(1))
      .map(function(m) {
        var start = ee.Date(startDate).advance(m, 'month');
        var end   = start.advance(1, 'month');
        
        return collection
          .filterDate(start, end)
          .sum()
          .multiply(scaleFactor)
          .rename(bandName)
          .set('system:time_start', start.millis())
          .set('month', start.format('YYYY-MM'));
      })
  );
}

// Aplicando
var gpmMonthly    = monthlyRainfall(gpm, 0.5, 'GPM_mm');      // 30 min
var chirpsMonthly = monthlyRainfall(chirps, 1, 'CHIRPS_mm');   // mm/dia
var trmmMonthly   = monthlyRainfall(trmm, 3, 'TRMM_mm');       // 3 horas

// ERA5-Land já é mensal → só converter de metros para mm
var runoffMonthly = era5.map(function(img) {
  return img.multiply(1000).rename('Runoff_mm')   // m → mm
    .copyProperties(img, ['system:time_start'])
    .set('month', ee.Date(img.get('system:time_start')).format('YYYY-MM'));
});

// ------------------------- 5. EXTRAIR VALORES MÉDIOS NA BACIA -------------------------
function extractMean(image) {
  var stats = image.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: bacia,
    scale: 10000,        // 10 km (adequado para ERA5 e os produtos de chuva)
    maxPixels: 1e13
  });
  return image.set(stats);
}

var gpmStats     = gpmMonthly.map(extractMean);
var chirpsStats  = chirpsMonthly.map(extractMean);
var trmmStats    = trmmMonthly.map(extractMean);
var runoffStats  = runoffMonthly.map(extractMean);

// ------------------------- 6. TABELAS -------------------------
function toTable(collection, valueName) {
  return collection.map(function(img) {
    return ee.Feature(null, {
      'date': img.get('month'),
      'value': img.get(valueName)
    });
  });
}

var gpmTable     = toTable(gpmStats, 'GPM_mm');
var chirpsTable  = toTable(chirpsStats, 'CHIRPS_mm');
var trmmTable    = toTable(trmmStats, 'TRMM_mm');
var runoffTable  = toTable(runoffStats, 'Runoff_mm');

// Imprime no console
print('=== Chuva mensal GPM (mm) ===', gpmTable);
print('=== Chuva mensal CHIRPS (mm) ===', chirpsTable);
print('=== Chuva mensal TRMM (mm) ===', trmmTable);
print('=== Escoamento mensal ERA5-Land (mm) ===', runoffTable);

// ------------------------- 7. GRÁFICOS -------------------------
print(ui.Chart.feature.byFeature(gpmTable, 'date', 'value')
  .setChartType('ColumnChart')
  .setOptions({title: 'Chuva mensal GPM (mm)', vAxis: {title: 'mm'}, legend: {position: 'none'}}));

print(ui.Chart.feature.byFeature(chirpsTable, 'date', 'value')
  .setChartType('ColumnChart')
  .setOptions({title: 'Chuva mensal CHIRPS (mm)', vAxis: {title: 'mm'}, legend: {position: 'none'}}));

print(ui.Chart.feature.byFeature(trmmTable, 'date', 'value')
  .setChartType('ColumnChart')
  .setOptions({title: 'Chuva mensal TRMM (mm)', vAxis: {title: 'mm'}, legend: {position: 'none'}}));

print(ui.Chart.feature.byFeature(runoffTable, 'date', 'value')
  .setChartType('ColumnChart')
  .setOptions({title: 'Escoamento mensal - ERA5-Land (mm)', vAxis: {title: 'mm'}, legend: {position: 'none'}}));

