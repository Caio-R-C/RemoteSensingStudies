// Sentinel 2
// Funcao para calcular NDWI
var makeNDWI = function(image) {
  var ndwi = image.expression(
    '(GREEN - NIR) / (GREEN + NIR)',
    {
      'NIR': image.select('B8'),  // NIR
      'GREEN': image.select('B3')  // Green
    }).rename('NDWI');
  return image.addBands(ndwi);
};

