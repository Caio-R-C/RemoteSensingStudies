// Funcao para converter mascara binaria em vetor poligonal e para calcular area de inundacao (ha)
function maskToMainPolygon(maskImage, geometry, scale) {
  var vectors = maskImage.reduceToVectors({
    geometry: geometry,
    scale: scale,
    geometryType: 'polygon',
    eightConnected: true,
    labelProperty: 'water',
    maxPixels: 1e13
  });

  var withArea = vectors.map(function(f) {
    var area = f.geometry().area(1);  // margem de erro de 1 metro
    return f.set('area', area);
  });

  var mainPolygon = withArea.sort('area', false).first(); // pega o primeiro direto

  var areaHa = ee.Number(mainPolygon.get('area')).divide(10000); // converte para hectares

  return {
    polygon: ee.Feature(mainPolygon),
    area_ha: areaHa
  };
}

