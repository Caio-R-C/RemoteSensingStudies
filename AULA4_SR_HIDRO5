}

// Atualiza legenda de acordo com os checkboxes ativados
function updateLegend() {
  legend.clear();
  legend.add(ui.Label('Legenda', {fontWeight: 'bold'}));

  var n = controlPanel.widgets().length();
  for (var i = 1; i < n; i++) {  // Começa de 1 para pular o título "Camadas Visíveis"
    var widget = controlPanel.widgets().get(i);
    if (widget.getValue && widget.getValue()) {
      var name = widget.getLabel();
      var color = getLayerColor(name);
      var colorBox = ui.Label('', {
        backgroundColor: color,
        padding: '8px',
        margin: '0 4px 0 0'
      });
      var label = ui.Label(name);
      var row = ui.Panel([colorBox, label], ui.Panel.Layout.Flow('horizontal'));
      legend.add(row);
    }
  }
}
