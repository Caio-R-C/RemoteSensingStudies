// Sentinel 1
// Funcao Filtro de Lee
function leeFilter(img, size, enl) {
  // https://github.com/senbox-org/s1tbx/blob/master/s1tbx-op-sar-processing/src/main/java/org/esa/s1tbx/sar/gpf/filtering/SpeckleFilters/Lee.java
  enl = enl || 1.0;
  var cu = 1.0 / Math.sqrt(enl);
  var cu2 = cu * cu;

  var kernel = ee.Kernel.square(size / 2, 'pixels', false);

  var mean = img.reduceNeighborhood({
    reducer: ee.Reducer.mean(),
    kernel: kernel
  });

  var variance = img.reduceNeighborhood({
    reducer: ee.Reducer.variance(),
    kernel: kernel
  });

  var ci = variance.sqrt().divide(mean);
  var cp = img;
  var valid = mean.gt(0).and(variance.gt(0));

  var w = ee.Image(1).subtract(ee.Image.constant(cu2).divide(ci.multiply(ci)));
  w = w.clamp(0, 1);

  var result = cp.multiply(w).add(mean.multiply(ee.Image(1).subtract(w)));
  result = result.updateMask(valid).set('system:time_start', img.get('system:time_start'));

  return result;
}

// Funcao converter de dB
function toNatural(img) {
  return ee.Image(10.0).pow(img.select(0).divide(10.0));
}

// Funcao converter para dB
function toDB(img) {
  return ee.Image(img).log10().multiply(10.0);
}

// Aplicar o filtro de Lee
