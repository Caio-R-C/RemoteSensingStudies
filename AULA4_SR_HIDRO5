// Funcao para adicionar checkbox e controlar layer
function addLayerCheckbox(layer, label) {
  var checkbox = ui.Checkbox(label, false);
  checkbox.onChange(function(checked) {
    layer.setShown(checked);
    updateLegend();  // Atualiza a legenda dinâmica
  });
  controlPanel.add(checkbox);
}
