//Applying function
var waterMask_MODIS = results.map(f_waterMask_SR_G1);

//DEFINING FUNCTION
//equacao todos rios Fassoni et al. 2019
var estimate_ssc = function(results) {
    var ssc = results.expression('exp((20*RED)+(7.68*NIR)+(0.31*(RED/NIR)))', {
        'NIR': results.select('sur_refl_b02').divide(10000), 
        'RED': results.select('sur_refl_b01').divide(10000), 
      }).rename('ssc');
return results.addBands([ssc]);
}; 

//equacao solimoes Villar et al.  2018
var estimate_ssc2 = function(results) {
    var ssc2 = results.expression('759.12*(NIR/RED)**1.92', {
        'NIR': results.select('sur_refl_b02').divide(10000), 
        'RED': results.select('sur_refl_b01').divide(10000), 
      }).rename('ssc2');
return results.addBands([ssc2]);
}; 

//equacao madeira Villar et al.  2013
var estimate_ssc3 = function(results) {
    var ssc3 = results.expression('1020*(NIR/RED)**2.94', {
        'NIR': results.select('sur_refl_b02').divide(10000), 
        'RED': results.select('sur_refl_b01').divide(10000), 
      }).rename('ssc3');
return results.addBands([ssc3]);
}; 

//equacao Orinoco Yepez et al. 2018
var estimate_ssc4 = function(results) {
    var ssc4 = results.expression('1.35512*(NIR)*1000-2.9385', {
        'NIR': results.select('sur_refl_b02').divide(10000), 
        'RED': results.select('sur_refl_b01').divide(10000), 
      }).rename('ssc4');
return results.addBands([ssc4]);
}; 

//APPLYING FUNCTION
results = waterMask_MODIS.map(estimate_ssc);
var results2 = waterMask_MODIS.map(estimate_ssc2);
var results3 = waterMask_MODIS.map(estimate_ssc3);
var results4 = waterMask_MODIS.map(estimate_ssc4);


