// PASSO 1
var gpm = ee.ImageCollection('NASA/GPM_L3/IMERG_V07').select("precipitation");
var chirps = ee.ImageCollection("UCSB-CHG/CHIRPS/DAILY");

// PASSO 2 (mantido)
var evento1_GPM = gpm.filterDate("2021-01-27","2021-01-28");
var evento1_CHIRPS = chirps.filterDate("2021-01-27","2021-01-28");
var evento2_GPM = gpm.filterDate("2020-12-16","2020-12-17");
var evento2_CHIRPS = chirps.filterDate("2020-12-16","2020-12-17");

// PASSO 3 (corrigido)
var gpmSum  = evento1_GPM.sum().multiply(0.5);   // mm totais do dia
var chirpsSum = evento1_CHIRPS.sum();
var gpmSum2 = evento2_GPM.sum().multiply(0.5);
var chirpsSum2 = evento2_CHIRPS.sum();

// PASSO 4
Map.addLayer(gpmSum,  {min:0, max:400, palette:"red,orange,blue,darkblue"}, "GPM evento 27-28/01/2021");
Map.addLayer(chirpsSum, {min:0, max:400, palette:"red,orange,blue,darkblue"}, "CHIRPS evento 27-28/01/2021");
Map.addLayer(gpmSum2, {min:0, max:400, palette:"red,orange,blue,darkblue"}, "GPM evento 16-17/12/2020");
Map.addLayer(chirpsSum2,{min:0, max:400, palette:"red,orange,blue,darkblue"}, "CHIRPS 16-17/12/2020");

