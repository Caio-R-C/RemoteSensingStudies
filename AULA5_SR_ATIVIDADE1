//Esta rotina calcula as medias mensais e anuais para o Brasil, para o Rio Grande do Sul e para a Amazônia
//primeiramente para um longo periodo de 2000 a 2024, depois apenas para 2024
//ela tambem calcula a diferenca entre a media anual de longo periodo e a media anual 2024
//ao todo sao gerados seis graficos no console e tres mapas

//ANTES DE INICIAR E PRECISO:
//PASSO1: adicionar os shapefiles BR.zip e rs.zip nos Assets>NEW>shapefiles
//PASSO2: basta alterar o caminho para seu usuario nas linhas 17 e 19 

//importa a colecao e os shapefiles do brasil e do rs para calculo das medias mensais
var chirps = ee.ImageCollection("UCSB-CHG/CHIRPS/DAILY");
var BR = ee.FeatureCollection('users/ocorrencia/BR');
                                   //alterar para seu usuario
var RS = ee.FeatureCollection('users/ocorrencia/rs');
                                  //alterar para seu usuario
var AM = ee.FeatureCollection('users/ocorrencia/Amazon');
                                  //alterar para seu usuario
                                  
// set start and end year
var startyear = 2000; 
var endyear = 2023; 
// make a date object
var startdate = ee.Date.fromYMD(startyear, 1, 1);
var enddate = ee.Date.fromYMD(endyear + 1, 1, 1);
// make a list with years
var years = ee.List.sequence(startyear, endyear);
// make a list with months
var months = ee.List.sequence(1, 12);
// Specify Country names
var area = BR;

//agregagando os dados mensalmente
var monthlyPrecip =  ee.ImageCollection.fromImages(
  years.map(function (y) {
    return months.map(function(m) {
      var w = chirps.filter(ee.Filter.calendarRange(y, y, 'year'))
                    .filter(ee.Filter.calendarRange(m, m, 'month'))
                    .sum();
      return w.set('year', y)
              .set('month', m)
              .set('system:time_start', ee.Date.fromYMD(y, m, 1));
                        
    });
  }).flatten()
);

//criando mensal variavel para grafico
var meanMonthlyP =  ee.ImageCollection.fromImages(
  months.map(function (m) {
    var w = monthlyPrecip.filter(ee.Filter.eq('month', m)).mean();
    return w.set('month', m)
            .set('system:time_start',ee.Date.fromYMD(1, m, 1)); 
  }).flatten()
);

//variaveis para o grafico
var title = {
  title: 'Monthly precipitation Brasil (2000 - 2024)',
  hAxis: {title: 'Time'},
  vAxis: {title: 'Precipitation (mm)'},
};

//criando o grafico
var chartMonthly = ui.Chart.image.seriesByRegion({
  imageCollection: meanMonthlyP, 
  regions: BR,
  reducer: ee.Reducer.mean(),
  band: 'precipitation',
  scale: 2500,
  xProperty: 'system:time_start',
  seriesProperty: 'SITE'
}).setOptions(title)
  .setChartType('ColumnChart');

print(chartMonthly);//adicionando grafico ao console

//agregando os dados mensais anualmente
var annualPrecip = meanMonthlyP.reduce(ee.Reducer.sum());
// print(annualPrecip);//adicionando colecao ao console
//adicionando ao mapa precipitacao anual
Map.addLayer(annualPrecip,{min:0,max:2000,palette:"red,orange,blue,darkblue"},"Anual Mean 2000 - 2024");

