//ROTINA PARA VISUALIZACAO DE PRODUTOS DE PRECIPITACAO NO GEE
//LIMITADA AO TERRITÓRIO DO BRASIL
////////////////////////////////////////////////////////////////////////////////

// PASSO 1: importar as coleções
var gpm = ee.ImageCollection('NASA/GPM_L3/IMERG_V07').select("precipitation");
var chirps = ee.ImageCollection("UCSB-CHG/CHIRPS/DAILY");

// PASSO 1.1: Definir a área do Brasil
var brasil = ee.FeatureCollection("FAO/GAUL/2015/level0")
  .filter(ee.Filter.eq('ADM0_NAME', 'Brazil'))
  .geometry();

// PASSO 2: filtrar para o período de interesse + Brasil
var evento1_GPM = gpm
  .filterDate("2021-01-27", "2021-01-28")
  .filterBounds(brasil);

var evento1_CHIRPS = chirps
  .filterDate("2021-01-27", "2021-01-28")
  .filterBounds(brasil);

var evento2_GPM = gpm
  .filterDate("2020-12-16", "2020-12-17")
  .filterBounds(brasil);

var evento2_CHIRPS = chirps
  .filterDate("2020-12-16", "2020-12-17")
  .filterBounds(brasil);

// PASSO 3: Calcula o valor total de precipitação no período e corta no Brasil
var gpmSum  = evento1_GPM.sum().multiply(0.5).clip(brasil);   // mm totais
var chirpsSum = evento1_CHIRPS.sum().clip(brasil);

var gpmSum2 = evento2_GPM.sum().multiply(0.5).clip(brasil);
var chirpsSum2 = evento2_CHIRPS.sum().clip(brasil);

// PASSO 4: Adiciona ao mapa e centraliza no Brasil
Map.centerObject(brasil, 4);

Map.addLayer(gpmSum, {
  min: 0, 
  max: 150, 
  palette: ["red", "orange", "blue", "darkblue"]
}, "GPM 27-28/01/2021 - Brasil");

Map.addLayer(chirpsSum, {
  min: 0, 
  max: 150, 
  palette: ["red", "orange", "blue", "darkblue"]
}, "CHIRPS 27-28/01/2021 - Brasil");

Map.addLayer(gpmSum2, {
  min: 0, 
  max: 150, 
  palette: ["red", "orange", "blue", "darkblue"]
}, "GPM 16-17/12/2020 - Brasil");

Map.addLayer(chirpsSum2, {
  min: 0, 
  max: 150, 
  palette: ["red", "orange", "blue", "darkblue"]
}, "CHIRPS 16-17/12/2020 - Brasil");

// Contorno do Brasil (opcional)
Map.addLayer(brasil, {color: 'black'}, 'Limite do Brasil', false);

